{
  "builds": [
    {
      "src": "DietHelper/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9",
        "pip": "pip install -r requirements.txt",
        "build": "python manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "DietHelper/wsgi.py"
    }
  ]
}